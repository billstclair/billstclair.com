         <td>&amp;times;</td>

         <td>multiplication sign</td>
      </tr>

      <tr>
         <td>&nbsp;</td>

         <td>&amp;nbsp;</td>

         <td>non breaking space</td>
      </tr>

      <tr>
         <td>&not;</td>

         <td>&amp;not;</td>

         <td>not sign</td>
      </tr>

      <tr>
         <td>&para;</td>

         <td>&amp;para;</td>

         <td>paragraph sign</td>
      </tr>

      <tr>
         <td>&plusmn;</td>

         <td>&amp;plusmn;</td>

         <td>plus-minus sign</td>
      </tr>

      <tr>
         <td>&pound;</td>

