      <tr>
         <th align="left">Named Colours</th>

         <td><a href="netscapecolours.html">
            <img src="images/roundbutton.gif" width="25" height="25" border="0" alt="button">
            </a></td>

         <td>Alphabetically</td>

         <td><a href="netscapeRGB.html">
            <img src="images/roundbutton.gif" width="25" height="25" border="0" alt="button">
