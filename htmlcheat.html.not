         <td>pound sign</td>
      </tr>

      <tr>
         <td>&reg;</td>

         <td>&amp;reg;</td>

         <td>registered trade mark sign.  See also &trade; &amp;trade;</td>
      </tr>

      <tr>
         <td>&raquo;</td>

         <td>&amp;raquo;</td>

         <td>right guillemot</td>
      </tr>

      <tr>
         <td>&sect;</td>

