<span class='item-control blog-admin'>
<a class='quickedit' href='https://www.blogger.com/rearrange?blogID=7575061201749703300&amp;widgetType=BlogList&amp;widgetId=BlogList1&amp;action=editWidget&amp;sectionId=sidebar-right-1' onclick='return _WidgetManager._PopupConfig(document.getElementById("BlogList1"));' target='configBlogList1' title='Edit'>
