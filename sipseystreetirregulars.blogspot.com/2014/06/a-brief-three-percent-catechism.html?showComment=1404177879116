<span class='widget-item-control'>
<span class='item-control blog-admin'>
<a class='quickedit' href='https://www.blogger.com/rearrange?blogID=7575061201749703300&amp;widgetType=Text&amp;widgetId=Text14&amp;action=editWidget&amp;sectionId=sidebar-right-1' onclick='return _WidgetManager._PopupConfig(document.getElementById("Text14"));' target='configText14' title='Edit'>
